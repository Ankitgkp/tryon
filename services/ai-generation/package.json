{
  "name": "@tryon/ai-generation",
  "version": "0.0.0",
  "private": true,
  "description": "AI Generation Service — abstracts AI image-generation providers",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@openrouter/sdk": "^0.8.0",
    "@tryon/shared-types": "workspace:*",
    "fastify": "^5.2.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@tryon/eslint-config": "workspace:*",
    "@tryon/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
