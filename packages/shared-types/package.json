{
  "name": "@tryon/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types and interfaces for the try-on platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "devDependencies": {
    "@tryon/tsconfig": "workspace:*",
    "@tryon/eslint-config": "workspace:*",
    "typescript": "^5.6.0"
  }
}
